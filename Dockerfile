# Selects a lightweight Java 21 runtime image as the base for our application.
# JRE is sufficient to run the application; it does not include Maven or the Java compiler.
FROM eclipse-temurin:21-jre

# Sets /app as the working directory inside the Docker container.
# Subsequent relative file paths will be resolved from this directory.
WORKDIR /app

# Copies the JAR generated by Maven from the host's target directory into the image.
# Renames the copied file to app.jar for a consistent name.
COPY target/*.jar app.jar


# Specifies the command to execute when the container starts.
# Runs the Java application using the JAR file copied into /app.
ENTRYPOINT ["java", "-jar", "app.jar"]